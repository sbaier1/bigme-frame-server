# ============================================================================
# Bigme F7 Pro Custom Photo Server & Provisioning Configuration
# ============================================================================

# --- 1. Custom Server Public/Local Base URL ---
# Can be http:// or https:// (up to ~180 characters).
# Note: If using https://, ensure your reverse proxy enables TLS 1.2 with at least
# one static RSA cipher suite supported by the XR872 mbedTLS stack (e.g. TLS_RSA_WITH_AES_128_GCM_SHA256).
# Note: The API JSON responses themselves are AES-256-CBC encrypted by the firmware.
# Example local:  http://192.168.1.50:8086
# Example public: https://frame.yourdomain.com/your-secret-prefix
SERVER_BASE_URL=http://192.168.1.100:8086

# Optional: Secret path prefix to authenticate the frame and Optional Basic Auth for browser UI
# Example: SECRET_PATH_PREFIX=/s3cr3t-token-9876
SECRET_PATH_PREFIX=
# Optional: Protect the browser dashboard (/) and /rotate with HTTP Basic Auth (user:password)
DASHBOARD_BASIC_AUTH=
PORT=8086

# How often the frame should wake up from deep sleep to fetch a new photo (in seconds)
# 3600 = 1 hour, 14400 = 4 hours, 43200 = 12 hours, 86400 = 24 hours
WAKEUP_INTERVAL_SECONDS=14400

# --- 2. Wi-Fi Credentials (used by provision.py over USB) ---
# Must be a 2.4 GHz Wi-Fi network (XR872AT is 2.4 GHz 802.11b/g/n)
WIFI_SSID=Your_2.4GHz_WiFi_SSID
WIFI_PASSWORD=Your_WiFi_Password

# --- 3. Immich Configuration ---
# Base URL of your Immich instance (can be http:// or https://, the Python server fetches from here)
IMMICH_URL=https://immich.yourdomain.com
IMMICH_API_KEY=your_immich_api_key_here

# Optional: Pull photos from a specific Immich Album UUID.
# If left empty, pulls random favorite photos (or random photos ifIMMICH_FAVORITES_ONLY=false).
IMMICH_ALBUM_ID=
IMMICH_FAVORITES_ONLY=true

# Optional: Also allow dropping local images (.jpg/.png/.webp) into ./photos
LOCAL_PHOTOS_DIR=./photos

# --- 4. E-Ink Image Processing & Dithering Options ---
# Panel dimensions for Bigme F7 Pro (1024x600). Use 800x480 for standard F7.
PANEL_WIDTH=1024
PANEL_HEIGHT=600
# Crop mode: "cover" (center-crop to fill 1024x600) or "contain" (letterbox with white/black bars)
CROP_MODE=cover
# Apply auto-contrast + saturation/contrast/sharpness tuning for the 6-color E-Ink display
OPTIMIZE_FOR_EINK=true

# Dithering algorithm (DITHER_MODE):
#   - atkinson        : (Default) Bill Atkinson's error diffusion (diffuses 75% of error in serpentine order).
#                       Cleanest midtones/highlights and least salt-and-pepper grain.
#   - sierra-lite     : Sierra Lite 2-row serpentine kernel. Very smooth, fine grain.
#   - stucki          : Stucki 3-row serpentine kernel. Wide, smooth photographic gradients (great for skies/landscapes).
#   - floyd-steinberg : Serpentine Floyd-Steinberg with damped bleed. Classic crisp error diffusion without directional worms.
#   - bayer           : 8x8 Bayer ordered halftone matrix. Zero error propagation, structured retro/print look.
#   - pillow          : Legacy Pillow quantize(FLOYDSTEINBERG) for baseline comparison.
DITHER_MODE=atkinson

# Palette matching mode (PALETTE_MODE):
#   - calibrated      : (Default) Perceptual Redmean matching against measured Spectra 6 reflectance colors
#                       so foliage, skies, and skin tones use actual color pigments instead of black/white speckles.
#   - pure            : Matches against idealized neon sRGB primaries (0/255).
PALETTE_MODE=calibrated

# Error-diffusion bleed factor (0.0 to 1.0, default 0.85).
# Lowering to 0.70-0.80 reduces grain in bright skin tones and backgrounds; raising to 0.95-1.00 maximizes micro-detail.
DITHER_STRENGTH=0.85

# Pre-dither image enhancement multipliers (used when OPTIMIZE_FOR_EINK=true):
SATURATION=1.25
CONTRAST=1.10
SHARPNESS=1.15

